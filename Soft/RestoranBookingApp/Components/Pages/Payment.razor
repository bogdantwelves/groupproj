@page "/restaurant/payment"

@using Data.Restaurant.DTOs
@using Data.Restaurant.Enums
@using Domain.Restaurant.Interfaces

@inject IPaymentService PaymentService
@inject IOrderService OrderService

<h3>Payment</h3>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">
        @message
    </div>
}

<div class="mb-3">
    <label class="form-label">Order Id</label>
    <input class="form-control" @bind="OrderIdText" />
</div>

<div class="mb-3">
    <label class="form-label">Payment Method</label>
    <select class="form-control" @bind="selectedMethod">
        <option value="@PaymentMethod.Cash">Cash</option>
        <option value="@PaymentMethod.Card">Card</option>
        <option value="@PaymentMethod.Online">Online</option>
    </select>
</div>

<button class="btn btn-outline-secondary" @onclick="ConfirmOrderAsync">
    Confirm
</button>

<button class="btn btn-primary ms-2" @onclick="PayAsync" disabled="@(!isConfirmed)">
    Pay
</button>

@if (isConfirmed)
{
    <div class="mt-3 d-flex justify-content-end fw-semibold">
        <div>Total order price: @confirmedTotal.ToString("0.00") €</div>
    </div>
}

@code {
    private string orderIdText = string.Empty;

    private string OrderIdText
    {
        get => orderIdText;
        set
        {
            if (orderIdText == value)
                return;

            orderIdText = value;
            isConfirmed = false;
            confirmedOrderId = null;
            confirmedTotal = 0m;
        }
    }

    private PaymentMethod selectedMethod = PaymentMethod.Card;

    private string? message;

    private bool isConfirmed;
    private Guid? confirmedOrderId;
    private decimal confirmedTotal;

    private async Task ConfirmOrderAsync()
    {
        try
        {
            message = null;

            if (!Guid.TryParse(orderIdText, out var orderId))
            {
                message = "Invalid Order Id.";
                return;
            }

            confirmedTotal = await OrderService.GetOrderTotalAsync(orderId);
            confirmedOrderId = orderId;
            isConfirmed = true;
        }
        catch (Exception ex)
        {
            message = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task PayAsync()
    {
        try
        {
            message = null;

            if (!isConfirmed || confirmedOrderId is null)
            {
                message = "Please confirm the Order Id first.";
                return;
            }

            var dto = new PaymentDto
            {
                OrderId = confirmedOrderId.Value,
                Method = selectedMethod
            };

            await PaymentService.PayAsync(dto);

            message = "Payment completed successfully.";

            OrderIdText = string.Empty;
            selectedMethod = PaymentMethod.Card;
            isConfirmed = false;
            confirmedOrderId = null;
            confirmedTotal = 0m;
        }
        catch (Exception ex)
        {
            message = ex.InnerException?.Message ?? ex.Message;
        }
    }
}