@page "/restaurant/inventory"

@using Data.Restaurant.DTOs
@using Domain.Restaurant.Interfaces

@inject IInventoryService InventoryService

<h3>Inventory</h3>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">
        @message
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">
        @error
    </div>
}

<EditForm Model="newIngredient" OnValidSubmit="AddIngredientAsync" class="mb-4">
    <DataAnnotationsValidator />

    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Product</label>
            <InputText class="form-control" @bind-Value="newIngredient.Name" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Quantity</label>
            <InputNumber class="form-control" @bind-Value="newIngredient.Quantity" />
        </div>

        <div class="col-md-3">
            <button class="btn btn-primary w-100" type="submit" disabled="@isSubmitting">
                Add Product
            </button>
        </div>
    </div>
</EditForm>

@if (ingredients is null)
{
    <p>Loading...</p>
}
else if (ingredients.Count == 0)
{
    <p>No ingredients found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Quantity</th>
                <th>Low Stock Threshold</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var ingredient in ingredients)
            {
                <tr>
                    @if (editingIngredientId == ingredient.Id)
                    {
                        <td>
                            <InputText class="form-control" @bind-Value="editIngredient.Name" />
                        </td>
                        <td>
                            <InputNumber class="form-control" @bind-Value="editIngredient.Quantity" />
                        </td>
                        <td>
                            <InputNumber class="form-control" @bind-Value="editIngredient.LowStockThreshold" />
                        </td>
                    }
                    else
                    {
                        <td>@ingredient.Name</td>
                        <td>@ingredient.Quantity</td>
                        <td>@ingredient.LowStockThreshold</td>
                    }
                    <td>
                        @if (editingIngredientId == ingredient.Id)
                        {
                            <button class="btn btn-sm btn-success me-2" @onclick="SaveEditAsync" disabled="@isSubmitting">
                                Save
                            </button>
                            <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">
                                Cancel
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEdit(ingredient)">
                                Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteIngredientAsync(ingredient.Id)" disabled="@isSubmitting">
                                Delete
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<IngredientDto>? ingredients;

    private CreateIngredientDto newIngredient = new();

    private Guid? editingIngredientId;

    private UpdateIngredientDto editIngredient = new();

    private bool isSubmitting;

    private string? message;

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadIngredientsAsync();
    }

    private async Task AddIngredientAsync()
    {
        try
        {
            isSubmitting = true;
            error = null;
            message = null;

            await InventoryService.AddIngredientAsync(newIngredient);
            await LoadIngredientsAsync();

            message = "Product added successfully.";
            newIngredient = new CreateIngredientDto();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void StartEdit(IngredientDto ingredient)
    {
        error = null;
        message = null;
        editingIngredientId = ingredient.Id;
        editIngredient = new UpdateIngredientDto
        {
            Name = ingredient.Name,
            Quantity = ingredient.Quantity,
            LowStockThreshold = ingredient.LowStockThreshold
        };
    }

    private void CancelEdit()
    {
        editingIngredientId = null;
        editIngredient = new UpdateIngredientDto();
    }

    private async Task SaveEditAsync()
    {
        if (editingIngredientId is null)
            return;

        try
        {
            isSubmitting = true;
            error = null;
            message = null;

            await InventoryService.UpdateIngredientAsync(editingIngredientId.Value, editIngredient);
            await LoadIngredientsAsync();

            message = "Product updated successfully.";
            CancelEdit();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteIngredientAsync(Guid ingredientId)
    {
        try
        {
            isSubmitting = true;
            error = null;
            message = null;

            await InventoryService.DeleteIngredientAsync(ingredientId);
            await LoadIngredientsAsync();

            if (editingIngredientId == ingredientId)
                CancelEdit();

            message = "Product deleted successfully.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadIngredientsAsync()
    {
        try
        {
            ingredients = await InventoryService.GetIngredientsAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
