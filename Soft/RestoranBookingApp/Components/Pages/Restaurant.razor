@page "/restaurant"

<h1>Restaurant Booking App</h1>

<p>Simple restaurant booking, ordering and payment system.</p>

<div class="restaurant-actions row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-2">
    <div class="col">
        <NavLink class="btn btn-primary w-100 py-3 px-4" href="/restaurant/menu">View Menu</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-success w-100 py-3 px-4" href="/restaurant/create-reservation">Book a Table</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-secondary w-100 py-3 px-4" href="/restaurant/my-reservations">My Reservations</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-outline-dark w-100 py-3 px-4" href="/restaurant/reservations">Reservations</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-warning w-100 py-3 px-4" href="/restaurant/order">Create Order</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-outline-warning w-100 py-3 px-4" href="/restaurant/order-history">Order History</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-info w-100 py-3 px-4" href="/restaurant/payment">Payment</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-dark w-100 py-3 px-4" href="/restaurant/admin">Admin Dashboard</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-outline-primary w-100 py-3 px-4" href="/restaurant/tables">Tables</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-outline-secondary w-100 py-3 px-4" href="/restaurant/inventory">Inventory</NavLink>
    </div>
    <div class="col">
        <NavLink class="btn btn-outline-success w-100 py-3 px-4" href="/restaurant/staff">Staff</NavLink>
    </div>
</div>
