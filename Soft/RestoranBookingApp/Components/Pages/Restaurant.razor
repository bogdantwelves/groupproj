@page "/restaurant"

<h1>Restaurant Booking App</h1>

<p>Simple restaurant booking, ordering and payment system.</p>

<div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-primary" href="/restaurant/menu">View Menu</a>
    <a class="btn btn-success" href="/restaurant/create-reservation">Book a Table</a>
    <a class="btn btn-secondary" href="/restaurant/my-reservations">My Reservations</a>
    <a class="btn btn-warning" href="/restaurant/order">Create Order</a>
    <a class="btn btn-outline-warning" href="/restaurant/order-history">Order History</a>
    <a class="btn btn-info" href="/restaurant/payment">Payment</a>
    <a class="btn btn-dark" href="/restaurant/admin">Admin Dashboard</a>
    <a class="btn btn-outline-primary" href="/restaurant/tables">Tables</a>
    <a class="btn btn-outline-secondary" href="/restaurant/inventory">Inventory</a>
    <a class="btn btn-outline-success" href="/restaurant/staff">Staff</a>
</div>
