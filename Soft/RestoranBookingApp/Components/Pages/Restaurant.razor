@page "/restaurant"

<h1>Restaurant Booking App</h1>

<p>Simple restaurant booking, ordering and payment system.</p>

<div class="restaurant-actions row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-2">
    <div class="col">
        <a class="btn btn-primary w-100 py-3 px-4" href="/restaurant/menu">View Menu</a>
    </div>
    <div class="col">
        <a class="btn btn-success w-100 py-3 px-4" href="/restaurant/create-reservation">Book a Table</a>
    </div>
    <div class="col">
        <a class="btn btn-secondary w-100 py-3 px-4" href="/restaurant/my-reservations">My Reservations</a>
    </div>
    <div class="col">
        <a class="btn btn-warning w-100 py-3 px-4" href="/restaurant/order">Create Order</a>
    </div>
    <div class="col">
        <a class="btn btn-outline-warning w-100 py-3 px-4" href="/restaurant/order-history">Order History</a>
    </div>
    <div class="col">
        <a class="btn btn-info w-100 py-3 px-4" href="/restaurant/payment">Payment</a>
    </div>
    <div class="col">
        <a class="btn btn-dark w-100 py-3 px-4" href="/restaurant/admin">Admin Dashboard</a>
    </div>
    <div class="col">
        <a class="btn btn-outline-primary w-100 py-3 px-4" href="/restaurant/tables">Tables</a>
    </div>
    <div class="col">
        <a class="btn btn-outline-secondary w-100 py-3 px-4" href="/restaurant/inventory">Inventory</a>
    </div>
    <div class="col">
        <a class="btn btn-outline-success w-100 py-3 px-4" href="/restaurant/staff">Staff</a>
    </div>
</div>
