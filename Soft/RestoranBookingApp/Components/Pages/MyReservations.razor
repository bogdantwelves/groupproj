@page "/restaurant/my-reservations"

@using Data.Restaurant.DTOs
@using Data.Restaurant.Enums
@using Domain.Restaurant.Interfaces

@inject IBookingService BookingService

<h3>My Reservations</h3>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">
        @message
    </div>
}

<div class="mb-3">
    <label class="form-label">Customer Name</label>
    <input class="form-control" @bind="customerNameText" />
</div>

<button class="btn btn-primary mb-3" @onclick="LoadReservationsAsync">
    Load Reservations
</button>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (reservations is not null && reservations.Count == 0)
{
    <p>No reservations found.</p>
}
else if (reservations is not null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>DateTime</th>
                <th>Table Number</th>
                <th>Party Size</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var reservation in reservations)
            {
                <tr>
                    <td>@reservation.DateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @(reservation.TableNumber.HasValue
                            ? reservation.TableNumber.Value.ToString()
                            : "Not assigned")
                    </td>
                    <td>@reservation.PartySize</td>
                    <td>@reservation.Status</td>
                    <td>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-danger" disabled="@IsCancelDisabled(reservation)"
                                    @onclick="() => CancelReservationAsync(reservation.Id)">
                                Cancel
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteReservationAsync(reservation.Id)">
                                Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string customerNameText = string.Empty;

    private List<ReservationDto>? reservations;

    private string? message;

    private bool isLoading;

    private async Task LoadReservationsAsync()
    {
        try
        {
            message = null;
            isLoading = true;

            reservations = await BookingService.GetReservationsByCustomerAsync(customerNameText);

            if (reservations.Count == 0)
            {
                message = "No reservations found for this customer.";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CancelReservationAsync(Guid reservationId)
    {
        try
        {
            message = null;

            await BookingService.CancelReservationAsync(reservationId);

            message = "Reservation cancelled successfully.";

            await LoadReservationsAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private async Task DeleteReservationAsync(Guid reservationId)
    {
        try
        {
            message = null;

            await BookingService.DeleteReservationAsync(reservationId);

            message = "Reservation deleted successfully.";

            await LoadReservationsAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private static bool IsCancelDisabled(ReservationDto reservation)
    {
        return reservation.Status == ReservationStatus.Cancelled;
    }
}
