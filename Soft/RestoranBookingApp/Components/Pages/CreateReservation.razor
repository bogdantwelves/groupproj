@page "/restaurant/create-reservation"

@using Data.Restaurant.DTOs
@using Domain.Restaurant.Interfaces

@inject IBookingService BookingService

<h3>Create Reservation</h3>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">
        @message
    </div>
}

<EditForm Model="model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Customer Name</label>
        <InputText class="form-control" @bind-Value="model.CustomerName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Restaurant Name</label>
        <InputText class="form-control" @bind-Value="model.RestaurantName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Date</label>
        <InputDate class="form-control" @bind-Value="reservationDate" />
    </div>

    <div class="mb-3">
        <label class="form-label">Time</label>
        <InputSelect class="form-select" @bind-Value="reservationTimeText">
            @foreach (var timeOption in TimeOptions)
            {
                <option value="@timeOption">@timeOption</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Party Size</label>
        <InputNumber class="form-control" @bind-Value="model.PartySize" />
    </div>

    <button class="btn btn-primary" type="submit">
        Submit
    </button>
</EditForm>

@code {
    private CreateReservationDto model = new()
    {
        PartySize = 2
    };

    private DateTime reservationDate = DateTime.Today.AddDays(1);

    private string reservationTimeText = "19:00";

    private string? message;

    private static readonly string[] TimeOptions = Enumerable
        .Range(0, 25)
        .Select(x => TimeOnly.FromTimeSpan(TimeSpan.FromHours(10).Add(TimeSpan.FromMinutes(x * 30))).ToString("HH:mm"))
        .ToArray();

    private async Task SubmitAsync()
    {
        try
        {
            if (!TimeSpan.TryParse(reservationTimeText, out var reservationTime))
            {
                message = "Invalid reservation time.";
                return;
            }

            model.DateTime = reservationDate.Date.Add(reservationTime);

            await BookingService.CreateReservationAsync(model);

            message = "Reservation created successfully.";

            model = new CreateReservationDto
            {
                PartySize = 2
            };

            reservationDate = DateTime.Today.AddDays(1);
            reservationTimeText = "19:00";
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }
}
