@page "/restaurant/staff"

@using Data.Restaurant.DTOs
@using Data.Restaurant.Enums
@using Domain.Restaurant.Interfaces

@inject IStaffService StaffService

<h3>Staff</h3>

<h5 class="mt-3">Add Staff Member</h5>

<div class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-4">
        <label class="form-label">Name</label>
        <input class="form-control" @bind="createModel.FullName" />
    </div>

    <div class="col-12 col-md-3">
        <label class="form-label">Shift Hours</label>
        <input class="form-control" @bind="createModel.ShiftHours" />
    </div>

    <div class="col-12 col-md-3">
        <label class="form-label">Role</label>
        <select class="form-select" @bind="createModel.Role">
            @foreach (var role in staffRoles)
            {
                <option value="@role">@role</option>
            }
        </select>
    </div>

    <div class="col-12 col-md-2">
        <button class="btn btn-success w-100" @onclick="CreateStaffAsync">Add</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">
        @error
    </div>
}

@if (staffList is null)
{
    <p>Loading...</p>
}
else if (staffList.Count == 0)
{
    <p>No staff found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Shift Hours</th>
                <th>Role</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var staff in staffList)
            {
                <tr>
                    @if (editingStaffId == staff.Id)
                    {
                        <td>
                            <input class="form-control" @bind="editModel.FullName" />
                        </td>
                        <td>
                            <input class="form-control" @bind="editModel.ShiftHours" />
                        </td>
                        <td>
                            <select class="form-select" @bind="editModel.Role">
                                @foreach (var role in staffRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-primary me-2" @onclick="SaveEditAsync">Save</button>
                            <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">Cancel</button>
                        </td>
                    }
                    else
                    {
                        <td>@staff.FullName</td>
                        <td>@staff.ShiftHours</td>
                        <td>@staff.Role</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEdit(staff)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteStaffAsync(staff.Id)">Delete</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<StaffDto>? staffList;
    private string? error;

    private readonly StaffRole[] staffRoles = Enum.GetValues<StaffRole>();
    private Guid? editingStaffId;
    private UpdateStaffDto editModel = new();
    private CreateStaffDto createModel = new();

    private static readonly Guid SeededRestaurantId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            error = null;
            staffList = await StaffService.GetStaffAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task CreateStaffAsync()
    {
        try
        {
            error = null;

            var restaurantId = staffList?.FirstOrDefault()?.RestaurantId ?? SeededRestaurantId;

            var dto = new CreateStaffDto
            {
                FullName = createModel.FullName,
                ShiftHours = createModel.ShiftHours,
                Role = createModel.Role,
                RestaurantId = restaurantId
            };

            await StaffService.CreateStaffAsync(dto);

            createModel = new CreateStaffDto();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private void StartEdit(StaffDto staff)
    {
        error = null;
        editingStaffId = staff.Id;

        var role = StaffRole.Waiter;
        _ = Enum.TryParse(staff.Role, out role);

        editModel = new UpdateStaffDto
        {
            FullName = staff.FullName,
            ShiftHours = staff.ShiftHours,
            Role = role
        };
    }

    private void CancelEdit()
    {
        editingStaffId = null;
        editModel = new UpdateStaffDto();
    }

    private async Task SaveEditAsync()
    {
        if (editingStaffId is null)
            return;

        try
        {
            error = null;
            await StaffService.UpdateStaffAsync(editingStaffId.Value, editModel);
            CancelEdit();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task DeleteStaffAsync(Guid staffId)
    {
        try
        {
            error = null;
            await StaffService.DeleteStaffAsync(staffId);
            if (editingStaffId == staffId)
            {
                CancelEdit();
            }
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
